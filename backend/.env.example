# Copy this file to backend/.env (git-ignored) and fill in your Supabase values.
# Supabase → Project Settings → Database → Connection string → "Session pooler" (JDBC).
# Use the Session pooler (port 5432): it works over IPv4, which Render needs.
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=your-database-password

# Port for the API (Render sets this automatically).
PORT=8080

# Frontend addresses allowed to call the API, separated by commas. "*" is a wildcard.
# Example: https://frontend-phi-pied-58.vercel.app,https://frontend-*-pnx1.vercel.app
# A lone "*" allows any address (fine for local testing).
CORS_ORIGIN=*
